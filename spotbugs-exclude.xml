<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs findings which are by design; see the spotbugs profile in pom.xml -->
<FindBugsFilter
		xmlns="https://github.com/spotbugs/filter/3.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">
	<!-- mutable inputs and outputs are not copied, for performance -->
	<Match>
		<Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP,MS_MUTABLE_COLLECTION_PKGPROTECT"/>
	</Match>
	<!-- no Java serialization -->
	<Match>
		<Bug pattern="SE_BAD_FIELD,SE_TRANSIENT_FIELD_NOT_RESTORED,SE_COMPARATOR_SHOULD_BE_SERIALIZABLE"/>
	</Match>
	<!-- constructors validate their arguments; there are no finalizers -->
	<Match>
		<Bug pattern="CT_CONSTRUCTOR_THROW"/>
	</Match>
	<!-- internal iterators in hot loops, always used with hasNext() -->
	<Match>
		<Bug pattern="IT_NO_SUCH_ELEMENT"/>
	</Match>
</FindBugsFilter>
